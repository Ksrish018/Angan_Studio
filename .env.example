# Copy to .env and fill in. Never commit .env.

# Vaani AI (voice agent) - Developers > API Key
VAANI_API_KEY=

# HubSpot service key (contacts + deals read/write) - Development > Keys > Service Keys
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# Gemini - Google AI Studio
GEMINI_API_KEY=

# Neon Postgres (pooled for the app, unpooled for migrations)
NEON_PROJECT_ID=
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth (dashboard login)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Cal.com - Settings > Developer > API keys
CALCOM_API_KEY=

# Resend (sending access only)
RESEND_API_KEY=
RESEND_FROM=

# App
APP_URL=
VAANI_WEBHOOK_TOKEN=
GEMINI_MODEL=gemini-flash-latest
# Optional: send every handoff to one inbox while Resend has no verified domain
HANDOFF_OVERRIDE_TO=
FRONT_DESK_EMAIL=
# Optional unit rates in rupees
VAANI_INR_PER_MIN=
VAANI_INR_PER_CREDIT=
CRON_SECRET=
VAANI_AGENT_ID=
FOUNDER_EMAIL=
SENIOR_PHONE=
